{
  "name": "@aadiaiagent/observability-kit",
  "version": "0.1.0",
  "description": "Lightweight observability primitives: structured Logger, MetricsRegistry, and TraceContext with correlation IDs. Interview-sized, zero vendor lock-in.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "example": "tsx examples/basic.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "observability",
    "logging",
    "metrics",
    "tracing",
    "correlation-id"
  ],
  "author": "aadiaiagent-max",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aadiaiagent-max/observability-kit.git"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
